APP_NAME="Marketplace Pop Culture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works out of the box for local dev (see README). For production,
# switch to MySQL/MariaDB per the cahier des charges: DB_CONNECTION=mysql
# and uncomment/fill the lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketplace_pop_culture
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log writes emails (password resets, etc.) to storage/logs/laravel.log
# instead of actually sending them — fine for local dev. For a real mailer,
# switch to MAIL_MAILER=mailtrap-sdk (see README "Emails (Mailtrap)" section)
# and set MAILTRAP_API_KEY below — no SMTP host/port/credentials needed, it
# sends through Mailtrap's transactional API via railsware/mailtrap-php's
# Laravel bridge (config/mail.php).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Mailtrap transactional sending API — generate a token at
# https://mailtrap.io/api-tokens. Only used when MAIL_MAILER=mailtrap-sdk above.
MAILTRAP_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (self-hosted WebSocket server for real-time messaging).
# Run `php artisan reverb:start` alongside `php artisan serve` in dev.
# Regenerate APP_ID/KEY/SECRET for any real deployment — these are dev-only.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Stripe test keys — create a free account and grab test keys at
# https://dashboard.stripe.com/test/apikeys. Without these, checkout shows
# a clear "payment not configured" message instead of erroring.
STRIPE_KEY=
STRIPE_SECRET=
# For local testing: `stripe listen --forward-to localhost:8000/webhook/stripe`
# prints a whsec_... value to use here.
STRIPE_WEBHOOK_SECRET=
